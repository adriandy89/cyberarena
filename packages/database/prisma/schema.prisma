// CyberArena database schema.
// Phase 001: Better Auth core tables (user/session/account/verification) + our Role.
// Field names follow better-auth's expected camelCase keys (prisma adapter maps 1:1).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Custom field (better-auth additionalFields, see ADR-007).
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Content catalog (phase 002). Synced from packages/content by the seed;
// slugs/question ids are stable identifiers shared with the content sources.
// ---------------------------------------------------------------------------

model CatalogPath {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String
  level       String
  order       Int             @default(0)
  modules     CatalogModule[]

  @@map("CatalogPath")
}

model CatalogModule {
  id           String       @id @default(cuid())
  slug         String       @unique
  catalogPathId String
  catalogPath  CatalogPath  @relation(fields: [catalogPathId], references: [id], onDelete: Cascade)
  title        String
  description  String
  order        Int          @default(0)
  rooms        Room[]

  @@map("CatalogModule")
}

model Room {
  id               String    @id @default(cuid())
  slug             String    @unique
  catalogModuleId  String
  catalogModule    CatalogModule @relation(fields: [catalogModuleId], references: [id], onDelete: Cascade)
  title            String
  description      String
  difficulty       String
  type             String
  estimatedMinutes Int
  tags             String[]
  lab              String?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  tasks            Task[]

  @@map("Room")
}

model Task {
  id     String     @id // stable: <room-slug>-t<NN>
  roomId String
  room   Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  index  Int
  title  String
  body   String
  questions Question[]

  @@unique([roomId, index])
  @@map("Task")
}

model Question {
  id      String  @id // stable: <room-slug>-t<NN>-q<NN>
  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  prompt  String
  hint    String?
  kind    String
  options Json?
  index   Int
  answers Answer[]

  @@map("Question")
}

/// Answer hashes: NEVER selected by catalog queries nor exposed via the API.
model Answer {
  questionId String   @id
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerHash String
  kind       String

  @@map("Answer")
}

// ---------------------------------------------------------------------------
// Progress & gamification (phase 003). XP idempotency is enforced by the
// unique [userId, reason] constraint (ADR-011).
// ---------------------------------------------------------------------------

model QuestionSolved {
  userId      String
  questionId  String
  solvedAt    DateTime @default(now())

  @@id([userId, questionId])
  @@map("QuestionSolved")
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // "question:<questionId>" | "room-complete:<roomSlug>"
  createdAt DateTime @default(now())

  @@unique([userId, reason])
  @@index([userId, createdAt])
  @@map("XpEvent")
}

model UserBadge {
  userId     String
  badgeId    String   // static id or "path-complete:<pathSlug>"
  awardedAt  DateTime @default(now())

  @@id([userId, badgeId])
  @@map("UserBadge")
}
