# PRODUCTION stack environment — copy to .env (never commited).
# Real secrets live in infra/stacks/prod/secrets/ (compose secrets), not here.

# Public origin (must match the proxy's SITE_ADDRESS + https).
WEB_ORIGIN=https://localhost

# Database (the PASSWORD travels via secrets/postgres_password, alphanumerics only).
POSTGRES_USER=cyberarena
POSTGRES_DB=cyberarena

# Initial admin (only created on FIRST boot with an empty DB — ADR-009).
# Set a real password here or read the generated one in `docker compose logs api`.
BOOTSTRAP_ADMIN_EMAIL=admin@cyberarena.local

# Email (optional in prod; SMTP egress happens from the api via the frontend network).
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=CyberArena <no-reply@cyberarena.local>
SMTP_HOST=
SMTP_PORT=587

# Labs on demand (phase 011). The runner token lives in secrets/lab_runner_token and the
# flags in ./lab-flags (infra/scripts/lab-flags.sh infra/stacks/prod/lab-flags).
LABS_ENABLED=true
LAB_MAX_RUNNING=3
