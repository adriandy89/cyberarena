# Development stack environment — copy to infra/stacks/dev/.env (never commited)
POSTGRES_USER=cyberarena
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=cyberarena
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000

# --- Better Auth (dev defaults are safe; override the secret anyway) ---
# URL pública que llega a /api/auth (a través del rewrite de la web).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=CyberArena <no-reply@cyberarena.local>
# Admin inicial: SOLO se crea en el primer arranque con la BD vacía (ADR-009).
# Sin password definida se genera una aleatoria y se muestra en el log del api.
BOOTSTRAP_ADMIN_EMAIL=admin@cyberarena.local
# BOOTSTRAP_ADMIN_PASSWORD=

MAILPIT_UI_PORT=8025

# --- Labs on demand (phase 011): `--profile labs` + infra/scripts/lab-flags.sh infra/stacks/dev/lab-flags ---
LABS_ENABLED=false
# 32+ random chars, shared by the api and the lab-runner (openssl rand -hex 32).
LAB_RUNNER_TOKEN=
LAB_MAX_RUNNING=3
LAB_RUNNER_PORT=4100
