# Development stack environment — copy to infra/stacks/dev/.env (never committed).
POSTGRES_USER=cyberarena
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=cyberarena
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000

# --- Better Auth (dev defaults are safe; override the secret anyway) ---
# Public URL that reaches /api/auth (through the web's /api rewrite).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=CyberArena <no-reply@cyberarena.local>
# Initial admin: created ONLY on the first boot with an empty database (ADR-009).
# Without a password (8+ characters) a random one is generated and printed in
# the api log: docker compose ... --env-file infra/stacks/dev/.env logs api | grep "initial admin"
BOOTSTRAP_ADMIN_EMAIL=admin@cyberarena.local
# BOOTSTRAP_ADMIN_PASSWORD=

# Mailpit: web inbox, and SMTP published on 127.0.0.1 for an api on the host (`pnpm dev`).
MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# --- Labs on demand (phase 011): `--profile labs` + infra/scripts/lab-flags.sh infra/stacks/dev/lab-flags ---
LABS_ENABLED=false
# 32+ random chars, shared by the api and the lab-runner (openssl rand -hex 32).
LAB_RUNNER_TOKEN=
LAB_MAX_RUNNING=3
LAB_RUNNER_PORT=4100
# Tuning, handy to watch the reaper work (defaults shown):
# LAB_IDLE_TIMEOUT_MIN=10          # api: minutes without a heartbeat before a lab stops
# LAB_SWEEP_SECONDS=60             # api: reaper interval
# LAB_UNLEASED_GRACE_SECONDS=300   # runner: lifetime of a lab nobody reserved
# LAB_LOOP_SECONDS=30              # runner: deadline check interval
