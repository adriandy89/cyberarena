# CyberArena LAN deployment (phase 013) — `cyberarena.sh init` copies this to the
# stack folder as .env, filling __REPO_DIR__ and __LAN_IP__. Never commit the result.

# Absolute path of the git clone (build context, Caddyfile, scripts).
REPO_DIR=__REPO_DIR__

# The server's LAN address: the web is https://__LAN_IP__ (Caddy internal CA).
SITE_ADDRESS=__LAN_IP__
WEB_ORIGIN=https://__LAN_IP__

# Database (the PASSWORD travels via secrets/postgres_password). Published on
# 127.0.0.1 only, for backups and psql on the server itself.
POSTGRES_USER=cyberarena
POSTGRES_DB=cyberarena
POSTGRES_PORT=5433

# Initial admin (first boot with an empty DB only — ADR-009); its password is
# secrets/bootstrap_admin_password, printed once by `cyberarena.sh init`.
BOOTSTRAP_ADMIN_EMAIL=admin@cyberarena.local

REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=CyberArena <no-reply@cyberarena.local>
SMTP_HOST=
SMTP_PORT=587

# Labs on demand (phase 011) reachable from the LAN (phase 013). Any device on
# the network can reach a running lab (deliberately vulnerable apps): set
# LAB_BIND_ADDRESS=127.0.0.1 to keep them on the server only.
LABS_ENABLED=true
LAB_MAX_RUNNING=3
LAB_BIND_ADDRESS=__LAN_IP__
LAB_PUBLIC_HOST=__LAN_IP__
