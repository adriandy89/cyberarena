# ============================================================
# CyberArena — variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env reales. En Docker, cada stack tiene su
# propio .env en infra/stacks/<stack>/.env
# ============================================================

# --- Base de datos (host dev) ---
# Puerto expuesto por infra/stacks/dev (postgres)
DATABASE_URL="postgresql://cyberarena:cyberarena@localhost:5432/cyberarena?schema=public"

# --- Credenciales Postgres (las usa docker compose) ---
POSTGRES_USER=cyberarena
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=cyberarena
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=3001
API_HOST=0.0.0.0
# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# URL pública de la web (para emails y enlaces)
WEB_URL=http://localhost:3000

# --- Web (Next.js) ---
# URL pública de la API (server-side y client-side)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth (Better Auth, fase 001) ---
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-32byte-random-secret
BETTER_AUTH_URL=http://localhost:3001

# --- Email dev (Mailpit, fase 001) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
