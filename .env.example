# ============================================================
# CyberArena — environment for the apps running on your machine
# (`pnpm dev`, `pnpm db:migrate`, `pnpm db:seed`). Copy to .env and
# never commit it. The Docker stacks have their own templates:
# infra/stacks/<stack>/.env.example.
# ============================================================

# --- Database: the dev stack's postgres (infra/stacks/dev), published on localhost ---
# User, password, database and port must match infra/stacks/dev/.env.
DATABASE_URL="postgresql://cyberarena:dev-only-change-me@localhost:5432/cyberarena?schema=public"

# --- API (NestJS) ---
API_PORT=3001
API_HOST=0.0.0.0
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Public web URL (links in emails)
WEB_URL=http://localhost:3000
# Where the web's /api rewrite forwards requests (ADR-008)
API_URL=http://localhost:3001
# Reverse proxies trusted for X-Forwarded-For (per-IP rate limiting).
# Default: loopback, linklocal, uniquelocal. Any Express "trust proxy" value, or false.
# TRUST_PROXY=

# --- Auth (Better Auth) ---
# Public base URL of the API for better-auth (without /api)
BETTER_AUTH_URL=http://localhost:3001
# 32+ random characters (openssl rand -base64 32). The default is for local development only.
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
# true: sign-up requires confirming the email (see it in Mailpit)
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=CyberArena <no-reply@cyberarena.local>
# Initial admin, created only on the first boot with an empty database (ADR-009).
# Without a password (8+ characters) a random one is generated and logged once.
BOOTSTRAP_ADMIN_EMAIL=admin@cyberarena.local
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Email: Mailpit from the dev stack (inbox at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Labs on demand (phase 011, ADR-015) ---
# false: the lab panel shows the manual `docker compose` commands instead.
LABS_ENABLED=false
# The dev stack's runner (`--profile labs` publishes it on 127.0.0.1:4100)
LAB_RUNNER_URL=http://127.0.0.1:4100
# Same token as the runner (32+ characters: openssl rand -hex 32)
LAB_RUNNER_TOKEN=
# Policy (defaults: stop after 10 min without a heartbeat, 2 h extendable to 4 h, 3 labs at once)
# LAB_IDLE_TIMEOUT_MIN=10
# LAB_SESSION_MAX_MIN=120
# LAB_SESSION_CAP_MIN=240
# LAB_EXTEND_MIN=60
# LAB_MAX_RUNNING=3
# Host shown to students in lab URLs (LAN deployments, phase 013; default 127.0.0.1)
# LAB_PUBLIC_HOST=
