# ============================================================
# CyberArena — variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env reales. En Docker, cada stack tiene su
# propio .env en infra/stacks/<stack>/.env
# ============================================================

# --- Base de datos (host dev) ---
# Puerto expuesto por infra/stacks/dev (postgres).
# IMPORTANTE: la contraseña debe coincidir con POSTGRES_PASSWORD (y con el .env del stack).
DATABASE_URL="postgresql://cyberarena:cyberarena@localhost:5432/cyberarena?schema=public"

# --- Credenciales Postgres (las usa docker compose) ---
# Recuerda actualizar también DATABASE_URL si cambias la contraseña.
POSTGRES_USER=cyberarena
POSTGRES_PASSWORD=cyberarena
POSTGRES_DB=cyberarena
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=3001
API_HOST=0.0.0.0
# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# URL pública de la web (para emails y enlaces)
WEB_URL=http://localhost:3000
# URL server-side de la API para el rewrite /api de la web (ADR-008)
API_URL=http://localhost:3001

# --- Auth (Better Auth, fase 001) ---
# URL pública de base para better-auth (sin /api); en dev con rewrite apunta a la web
BETTER_AUTH_URL=http://localhost:3001
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-32byte-random-secret
# Si true, el registro exige verificar el email (Mailpit en dev)
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=CyberArena <no-reply@cyberarena.local>
# --- Bootstrap del admin inicial (solo primer arranque con BD vacía; ADR-009) ---
# Si no se define BOOTSTRAP_ADMIN_PASSWORD, se genera una aleatoria y se
# registra UNA vez en el log del arranque (cámbiala tras el primer login).
BOOTSTRAP_ADMIN_EMAIL=admin@cyberarena.local
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Labs bajo demanda (fase 011, ADR-015) ---
# Con false, el LabPanel muestra los comandos manuales de siempre.
LABS_ENABLED=false
# lab-runner del dev stack (--profile labs publica 127.0.0.1:4100)
LAB_RUNNER_URL=http://127.0.0.1:4100
# El mismo token que usa el runner (32+ caracteres; openssl rand -hex 32)
LAB_RUNNER_TOKEN=
# Política (por defecto: 10 min sin latido, 2 h ampliables a 4 h, 3 labs a la vez)
# LAB_IDLE_TIMEOUT_MIN=10
# LAB_SESSION_MAX_MIN=120
# LAB_SESSION_CAP_MIN=240
# LAB_MAX_RUNNING=3

# --- Email dev (Mailpit, fase 001) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
