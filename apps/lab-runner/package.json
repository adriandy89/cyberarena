{
  "name": "@repo/lab-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Starts and stops lab stacks on demand; the only service with Docker access (ADR-015)",
  "scripts": {
    "build": "tsx scripts/build-manifest.ts && tsc -p tsconfig.build.json",
    "manifest": "tsx scripts/build-manifest.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
